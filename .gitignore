# ============================================
# NeuraQuiz AI — .gitignore
# ============================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ---- Virtual Environments ----
.env
.venv
env/
venv/

# ---- Jupyter Notebook ----
.ipynb_checkpoints/

# ---- Node / Frontend ----
node_modules/
dist/
dist-ssr/
*.local

# ---- IDE / Editor ----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Large Data Files (NOT for Git) ----
# Raw RACE dataset (~468 MB)
dataset/

# Trained model weights (~180 MB)
race_rc_project/models/model_a/*.pkl
race_rc_project/models/model_a/*.pth
race_rc_project/models/model_a/*.csv
race_rc_project/models/model_b/*.pkl
race_rc_project/models/model_b/*.csv

# Processed feature data (~14 MB)
race_rc_project/data/processed/*.pkl
